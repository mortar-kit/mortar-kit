{
  "name": "mortar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "pnpm --filter mortar-example-site dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/core/tsconfig.build.json && tsc --noEmit -p packages/admin/tsconfig.build.json",
    "lint": "oxlint packages examples",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.2",
    "eslint-plugin-solid": "0.20.1",
    "jsdom": "31.0.1",
    "oxlint": "1.92.0",
    "solid-js": "2.0.3",
    "@solidjs/web": "2.0.3",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
