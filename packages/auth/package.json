{
  "name": "@mortar-kit/auth",
  "version": "0.2.0",
  "description": "Mortar auth: sign-in methods (Google, email), signed cookie sessions and route guards for the admin",
  "license": "MIT",
  "homepage": "https://docs.mortar-kit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortar-kit/mortar-kit.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/source/index.d.ts",
        "solid": "./dist/source/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@mortar-kit/core": "workspace:^"
  },
  "devDependencies": {
    "@mortar-kit/core": "workspace:*"
  }
}
