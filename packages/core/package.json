{
  "name": "@mortar-kit/core",
  "version": "0.0.0",
  "description": "Mortar core: bricks, schema fields, collections of documents, storage and rendering for Solid 2",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "solid": "./src/server.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/source/index.d.ts",
        "solid": "./dist/source/index.js"
      },
      "./server": {
        "types": "./dist/source/server.d.ts",
        "solid": "./dist/source/server.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  }
}
