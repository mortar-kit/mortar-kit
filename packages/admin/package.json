{
  "name": "@mortar-kit/admin",
  "version": "0.0.0",
  "description": "Mortar admin: schema-driven editor for collections and bricks, with live preview, for Solid 2",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts"
    },
    "./preview": {
      "types": "./src/preview.tsx",
      "solid": "./src/preview.tsx"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/source/index.d.ts",
        "solid": "./dist/source/index.js"
      },
      "./preview": {
        "types": "./dist/source/preview.d.ts",
        "solid": "./dist/source/preview.jsx"
      },
      "./vite": {
        "types": "./dist/source/vite.d.ts",
        "default": "./dist/source/vite.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.cpSync('src','dist/source',{recursive:true,filter:(f)=>!f.endsWith('/test')&&(fs.statSync(f).isDirectory()||f.endsWith('.css'))})\"",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@mortar-kit/core": "workspace:^",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0",
    "vite": ">=7"
  },
  "devDependencies": {
    "@mortar-kit/core": "workspace:*",
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3",
    "vite": "8.3.8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
